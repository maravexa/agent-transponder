# exporter.yml — managed by Ansible (metrics_exporter role)
# Manual edits will be overwritten on the next playbook run.
listen:
  address: "{{ metrics_exporter_listen_address }}"
  port: {{ metrics_exporter_listen_port }}
tls:
  cert: "{{ fr_tls_dir }}/exporter/cert.pem"
  key: "{{ fr_tls_dir }}/exporter/key.pem"
  ca: "{{ fr_tls_dir }}/ca/ca.crt"
findings:
  path: "{{ fr_data_dir }}/findings"
  poll_interval: "{{ metrics_exporter_poll_interval }}"
metrics:
  namespace: "{{ metrics_exporter_metrics_namespace }}"
logging:
  level: "{{ metrics_exporter_log_level }}"
