---
# flight-recorder.yml — Grafana dashboard provider provisioning
# Managed by Ansible (grafana role). Manual edits will be overwritten.

apiVersion: 1

providers:
  - name: Flight Recorder
    orgId: 1
    folder: Flight Recorder
    type: file
    disableDeletion: true
    updateIntervalSeconds: 30
    options:
      path: /var/lib/grafana/dashboards
      foldersFromFilesStructure: false
