---
# prometheus.yml — managed by Ansible (prometheus role)
# Manual edits will be overwritten on the next playbook run.

global:
  scrape_interval:     {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_eval_interval }}

rule_files:
  - "alert.rules.yml"

scrape_configs:
  - job_name: "prometheus"
    scheme: https
    tls_config:
      ca_file:   {{ tls_ca_cert }}
      cert_file: {{ fr_tls_dir }}/prometheus/cert.pem
      key_file:  {{ fr_tls_dir }}/prometheus/key.pem
    static_configs:
      - targets:
          - "localhost:{{ prometheus_listen_port }}"

  - job_name: "node_exporter"
    scheme: https
    tls_config:
      ca_file:   {{ tls_ca_cert }}
      cert_file: {{ fr_tls_dir }}/prometheus/cert.pem
      key_file:  {{ fr_tls_dir }}/prometheus/key.pem
    static_configs:
      - targets: {{ prometheus_node_exporter_targets | to_yaml | trim }}

  - job_name: "flight_recorder"
    scheme: https
    tls_config:
      ca_file:   {{ tls_ca_cert }}
      cert_file: {{ fr_tls_dir }}/prometheus/cert.pem
      key_file:  {{ fr_tls_dir }}/prometheus/key.pem
    static_configs:
      - targets: {{ prometheus_fr_exporter_targets | to_yaml | trim }}
