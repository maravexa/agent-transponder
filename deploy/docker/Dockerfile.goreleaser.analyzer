# GoReleaser builds the binary and COPYs it in.
# This Dockerfile just sets up the minimal runtime.
# extra_files paths are preserved relative to repo root in GoReleaser v2.
FROM gcr.io/distroless/static-debian12:nonroot

COPY deploy/docker/passwd /etc/passwd
COPY at-analyzer /

USER 65534:65534
ENTRYPOINT ["/at-analyzer"]
